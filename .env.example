# ===== App =====
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# ===== Database (docker-compose defaults) =====
DATABASE_URL=postgresql://omni:omni@localhost:5432/omni

# ===== Redis / BullMQ =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ===== OpenAI (used by Strands agent) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embedding model for knowledgebase vector search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== AI Agentic (LangChain ecosystem) =====
# Model chat chính cho agent trả lời
AI_CHAT_MODEL=gpt-4o-mini
# Model nhỏ cho hybrid classifier
AI_CLASSIFY_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# ===== Facebook / Meta =====
# App-level: used to verify X-Hub-Signature-256 of webhook payloads
META_APP_SECRET=
# Global fallback verify token for webhook handshake (per-page tokens override this)
WEBHOOK_VERIFY_TOKEN=

# ===== Crypto for stored page access tokens =====
# 32-byte hex key used to encrypt Page access tokens at rest
ENCRYPTION_KEY=

# ===== Strands SDK =====
# Strands defaults to Bedrock; we force OpenAI provider via OPENAI_* above.
# Set STRANDS_DEBUG=1 for verbose agent traces
STRANDS_DEBUG=0
